    // The boss changes phase at certain health levels.
    "phases": {
      // Use phases.
      "enabled": true,
      // Announce a new phase in the chat.
      "announcePhaseChanges": true,
      // Phase 2 starts below this much health (percent).
      "phase2HealthPercent": 70,
      // Phase 3 starts below this much health (percent).
      "phase3HealthPercent": 35,
      // Boss bar colour: PINK, BLUE, RED, GREEN, YELLOW, PURPLE or WHITE.
      "phase1BossBarColor": "GREEN",
      // Boss bar colour in phase 2.
      "phase2BossBarColor": "YELLOW",
      // Boss bar colour in phase 3.
      "phase3BossBarColor": "RED",
      // Chat message at the start of phase 2.
      "phase2Message": "Sylvaron enters Phase 2: The Grove Awakens!",
      // Chat message at the start of phase 3.
