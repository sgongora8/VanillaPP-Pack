    // The boss gets stronger when more players fight it.
    "raidScaling": {
      // Scale health and damage with the number of players.
      "enabled": true,
      // Tell players when the boss scales up.
      "announceChanges": true,
      // Never scale back down when players leave.
      "onlyScaleUp": true,
      // Players the base values are made for.
      "basePlayerCount": 1,
      // Scale for at most this many players.
      "maxScaledPlayers": 8,
      // A player stops counting after this long without hitting the boss.
      "activeParticipantTimeoutSeconds": 45,
      // Players within this many blocks can count.
      "activeParticipantRadius": 96,
      // Extra health for every player above the base count, in percent.
      "healthPerExtraPlayerPercent": 45.0,
      // Extra damage for every player above the base count, in percent.
      "damagePerExtraPlayerPercent": 8.0
