      // Skill damage in phase 3 is multiplied by this.
      "phase3DamageMultiplier": 1.25,
      // More particles in phase 2.
      "phase2ParticleMultiplier": 1.2,
      // More particles in phase 3.
      "phase3ParticleMultiplier": 1.5,
      // Particles when the phase changes.
      "phaseChangeParticles": 120,
      // Players within this many blocks see the phase message.
      "phaseBroadcastRadius": 96
    },
    // Sylvaron: a burst of spores that poisons and blinds.
    "sporeBurst": {
      // Seconds of poison.
      "poisonDurationSeconds": 5,
      // Poison level (0 = level I).
      "poisonAmplifier": 0,
      // Seconds of blindness.
      "blindnessDurationSeconds": 3,
      // Seconds of darkness.
      "darknessDurationSeconds": 4,
      // Warning time before the skill hits (20 ticks = 1 second).
      "warningDelayTicks": 40,
      // Turn this on or off.
      "enabled": true,
      // Seconds after the boss appears before it may use this skill.
      "initialDelaySeconds": 4,
      // Seconds before the skill can be used again.
      "cooldownSeconds": 9,
      // Range of the skill, in blocks.
      "radius": 8.0,
      // Particles shown for it.
      "particleCount": 100
    },
    // Sylvaron: a root that shoots at a player and holds them in place.
    "rootPrison": {
