// World Bosses settings. Lines starting with // explain the setting below them.
// After changes, use /worldbosses reload or restart the server.
// Delete this file to get the defaults back.
// Times: "ticks" are 1/20 of a second. Damage and health: 2 = one heart.
{
  // Tells joining players which World Bosses version the server runs.
  "versionCheck": {
    // Send the server's version to players when they join.
    "enabled": true
  },
  // Extra output for testing boss fights. Leave off on a normal server.
  "debug": {
    // Debug mode: bosses print what they do, and the mace limits are switched off.
    "enabled": false,
    // Show debug messages in the chat of players nearby.
    "broadcastToPlayers": true,
    // Write debug messages to the server log.
    "logToConsole": true,
    // Players within this many blocks get the debug messages.
    "broadcastRadius": 96,
    // Sylvaron: report who was hit by his roots.
    "showRootImpactResults": true
  },
  // Turn groups of chat messages on or off.
  "messages": {
    // Why a ritual cannot start (wrong dimension, boss already alive nearby, ...).
    "validationMessages": true,
    // Messages when using a shrine.
    "shrineMessages": true,
    // The countdown while a ritual runs.
    "ritualCountdownMessages": true,
    // Announcements when a boss enters a new phase.
    "phaseMessages": true,
    // Notes when a boss gets stronger because more players joined.
    "raidScalingMessages": true,
    // Messages about rewards after a kill.
    "rewardMessages": true,
    // Messages when a raid cache is opened.
    "raidCacheMessages": true,
    // The server version message on join.
    "versionCheckMessages": true,
    // Results of the Shrine Locator and the Realm Compass.
    "locatorMessages": true,
    // Log each placed shrine in the chat. Only useful for testing.
    "worldGenerationMessages": false
  },
  // Where and how the boss shrines are placed in the world.
  "worldGeneration": {
    // Place shrines in the world at all.
    "enabled": true,
    // How often (in ticks, 20 = 1 second) the mod looks for places to put new shrines near players.
    "checkIntervalTicks": 80,
    // Look for shrine spots within this many chunks around each player (max 12).
    "playerChunkRadius": 7,
    // Blocks cleared around a shrine so it is not buried.
    "shrineClearRadius": 6,
    // How high above a shrine blocks are cleared.
    "shrineClearHeight": 9,
    // Search for flat ground and fill gaps under shrines.
    "stabilizeShrineTerrain": true,
    // How far to search for flat ground around the planned spot.
    "shrineTerrainSearchRadius": 8,
    // Most height difference allowed on the ground under a shrine.
    "maxShrineTerrainHeightDifference": 4,
    // Build a foundation under shrines that stand over a drop.
    "buildShrineFoundations": true,
    // How deep such a foundation may go.
    "shrineFoundationDepth": 10,
    // Wider search if no flat ground was found close by.
    "fallbackShrineTerrainSearchRadius": 32,
    // Height difference allowed during that wider search.
    "fallbackMaxShrineTerrainHeightDifference": 10,
    // How many spots are tried per region before giving up (1-16).
    "maxPlacementAttemptsPerRegion": 4,
    // Let bosses be summoned at generated shrines even outside their allowed biomes.
    "ignoreBiomeRulesForGeneratedShrines": true,
    // Place Overworld shrines.
    "generateOverworldShrines": true,
    // Place Nether shrines.
    "generateNetherShrines": true,
    // Place End shrines.
    "generateEndShrines": true,
    // Place the Primordial Nexus shrines for Astrael.
    "generatePrimordialNexusShrines": true,
    // Spacing of Overworld shrines.
    "overworldShrine": {
      // About one shrine per square of this many chunks (16 blocks each). Higher = rarer.
      "spacingChunks": 34,
      // Random seed for the placement. Change it to move all shrines of this type.
      "salt": 925813
    },
    // Spacing of Nether shrines.
    "netherShrine": {
      // About one shrine per square of this many chunks (16 blocks each). Higher = rarer.
      "spacingChunks": 38,
      // Random seed for the placement. Change it to move all shrines of this type.
      "salt": 492271
    },
    // Spacing of End shrines.
    "endShrine": {
      // About one shrine per square of this many chunks (16 blocks each). Higher = rarer.
      "spacingChunks": 52,
      // Random seed for the placement. Change it to move all shrines of this type.
      "salt": 823111
    },
    // Spacing of Primordial Nexus shrines.
    "primordialNexusShrine": {
      // About one shrine per square of this many chunks (16 blocks each). Higher = rarer.
      "spacingChunks": 118,
      // Random seed for the placement. Change it to move all shrines of this type.
      "salt": 1289971
    }
  },
  // Particles and sounds around shrines.
  "shrineAtmosphere": {
    // Particles and sounds around shrines.
    "enabled": true,
    // How often shrines near players are updated (ticks).
    "scanIntervalTicks": 20,
    // Shrines within this many blocks of a player get effects.
    "scanHorizontalRadius": 14,
    // Same, but up and down.
    "scanVerticalRadius": 5,
    // Particles per update.
    "particlesPerPulse": 14,
    // Play ambient shrine sounds.
    "ambientSounds": true,
    // A sound plays about once every this many updates.
    "soundChancePerPulse": 14
  },
  // Extra particles around living bosses.
  "bossVisuals": {
    // Extra particles around living bosses.
    "enabled": true,
    // How often particles are shown (ticks).
    "particleIntervalTicks": 10,
    // Only show them if a player is within this many blocks.
    "playerScanRadius": 96,
    // Particles each time.
    "particlesPerPulse": 4,
    // Second particle type about once every this many times.
    "secondaryParticleChance": 4,
    // Stronger particles when a boss is low on health.
    "enragePulse": true,
    // Health share (0.34 = 34%) below which the stronger particles start.
    "enrageHealthPercent": 0.34,
    // Extra particles when low on health.
    "enrageExtraParticles": 4
  },
  // The effects when a boss appears.
  "bossIntro": {
    // Show the entrance effects when a boss appears.
    "enabled": true,
    // Players within this many blocks see the intro message.
    "broadcastRadius": 96,
    // More (above 1) or fewer (below 1) intro particles.
    "particleMultiplier": 1.0,
    // Play the intro sounds.
    "playSounds": true,
    // Show the second intro particle type.
    "playSecondaryParticles": true
  },
  // Bosses slowly heal while they fight, faster the more players take part.
  "bossSelfHeal": {
    // Bosses heal while they fight.
    "enabled": true,
    // Health healed per second.
    "baseHealPerSecond": 1.0,
    // Extra healing per second for every player in the fight.
    "healPerActivePlayerPerSecond": 0.5,
    // Players within this many blocks count as in the fight.
    "activeParticipantRadius": 96,
    // Heal at least as if this many players were fighting.
    "minActivePlayers": 1,
    // Count at most this many players.
    "maxScaledPlayers": 8,
    // Only heal while the boss has someone to fight.
    "requireCombatTarget": true,
    // Stop healing when no player is near.
    "pauseWhenNoPlayersNearby": true,
    // Wait this long after the boss appears before it starts healing.
    "startDelaySeconds": 10,
    // Heal in steps every this many seconds.
    "tickIntervalSeconds": 2,
    // Never heal more than this percent of max health per second (0 = no limit).
    "maxHealPercentPerSecond": 1.0
  },
  // A damage aura that hits players who stay close to a boss.
  "bossCombatPressure": {
    // Damage aura around bosses.
    "enabled": true,
    // Seconds between two hits of the aura.
    "tickIntervalSeconds": 6,
    // Players within this many blocks are hit.
    "radius": 10,
    // Damage per hit (2 = one heart).
    "damage": 1.5,
    // Extra damage per player in the fight.
    "damagePerActivePlayer": 0.35,
    // Count at most this many players.
    "maxScaledPlayers": 8,
    // How long the aura's effects last.
    "effectDurationSeconds": 4,
    // Apply the boss's effects (slowness, weakness, ...).
    "enableDebuffs": true,
    // Deal the aura damage.
    "enableDamageOverTime": true,
    // Show particles for the aura.
    "enableParticles": true,
    // Play sounds for the aura.
    "enableSounds": true,
    // More or fewer aura particles.
    "particleMultiplier": 1.0,
    // Morvath heals by this share of the aura damage he deals (0 = off).
    "morvathLifeStealMultiplier": 1.0
  },
  // Settings that apply to all bosses: global multipliers, arena rules, limits.
  "bossScaling": {
    // Use the settings of this section.
    "enabled": true,
    // Multiplies the health of every boss.
    "globalHealthMultiplier": 1.0,
    // Multiplies the damage of every boss.
    "globalDamageMultiplier": 1.0,
    // Multiplies the XP every boss drops.
    "globalXpMultiplier": 1.0,
    // Extra raid caches each player gets per kill.
    "extraRaidCaches": 0,
    // Most bosses that may be alive at once near a shrine (0 = no limit).
    "maxAliveBossesPerWorld": 5,
    // Heal and pull back bosses whose fight leaves the arena (pillaring, luring away).
    "enableAntiCheese": true,
    // Radius of the arena around the spawn point, in blocks.
    "arenaRadius": 64,
    // The boss may go this far past the arena before it is pulled back.
    "bossLeashExtraRadius": 32,
    // Healing per second while all players are outside the arena.
    "outOfArenaHealPerSecond": 1.0,
    // Healing per second while the boss itself is outside the arena.
    "bossOutsideArenaHealPerSecond": 0.5,
    // Teleport a boss back that stays outside the arena too long.
    "teleportBossBackToArena": true,
    // How long outside the arena before it is teleported back.
    "teleportBackAfterSeconds": 20,
    // Seconds between two arena warnings to players.
    "warningIntervalSeconds": 10,
    // Radius in which living bosses are counted for maxAliveBossesPerWorld.
    "activeBossSearchRadius": 8192,
    // A boss disappears after this many seconds (86400 = 24 hours, 0 = never).
    "maxBossLifetimeSeconds": 86400,
    // Limit the damage of mace hits on bosses.
    "enableMaceDamageCap": true,
    // Most damage a single mace hit can deal to a boss.
    "maxMaceDamage": 18.0,
    // Players in creative mode count as fighters.
    "countCreativePlayersAsArenaParticipants": true,
    // Remove a boss when nobody has been near it for a while.
    "despawnWhenNoPlayersNearby": false,
    // How long with nobody near before it is removed.
    "despawnAfterNoPlayersSeconds": 1800,
    // Show arena warnings in the chat.
    "warningMessages": true,
    // Drop the rewards on the ground if nobody qualifies for them.
    "dropRewardsWhenNoEligiblePlayers": true,
    // Shrine rituals work in every dimension, e.g. Nether and End bosses in the Overworld. Biome rules then only apply in the boss's home dimension.
    "allowAnyDimension": false
  },
  // Limits for pets from the Loyal Companions mod, so they cannot kill bosses on their own.
  "loyalCompanionsCompatibility": {
    // Limit the damage pets deal to bosses.
    "enabled": true,
    // Pets may deal at most this share of a boss's max health in total (0.5 = 50%).
    "maxCompanionDamagePercentOfBossMaxHealth": 0.5,
    // Most damage per pet hit (0 = no limit).
    "maxCompanionDamagePerHit": 0.0,
    // Pet hits always deal at least this much.
    "minimumCompanionDamagePerHit": 1.0,
    // A pet's owner counts as fighter when the pet hits the boss.
    "recordCompanionOwnerAsParticipant": true,
    // Log when a pet hit was reduced.
    "debugDamageCaps": false
  },
  // The Shrine Locator Compass.
  "shrineLocator": {
    // How far the compass searches, in blocks.
    "locateRadiusBlocks": 4096,
    // Also show spots where a shrine will be placed once the area is explored.
    "includePredictedWorldgenCandidates": true,
    // Name the shrine type in the result.
    "showShrineType": true,
    // Show the coordinates.
    "showCoordinates": true,
    // Show the distance.
    "showDistance": true,
    // Play a sound when used.
    "playSound": true,
    // Show particles when used.
    "spawnParticles": true,
    // Build the found shrine right away if it only exists as a planned spot.
    "generatePredictedShrinesOnLocate": true
  },
  // What the bosses drop to open the Worldbreaker portal.
  "worldbreakerPortal": {
    // Least Worldbreaker Dust per player from each of the six first bosses.
    "dustPerBossMin": 2,
    // Most Worldbreaker Dust per player.
    "dustPerBossMax": 4,
    // Primordial Sparks per player from Astrael.
    "sparksPerAstraelKill": 1
  },
  // Natural mob spawning in the Worldbreaker realm.
  "realmSpawning": {
    // Most hostile mobs at once in the realm per player area (vanilla uses 70).
    "monsterCap": 50
  },
  // Settings for this boss. Skill sections of other bosses in here are not used by it.
  "sylvaron": {
    // Health. Values over 1024 work: the boss then takes less damage per hit instead.
    "maxHealth": 450.0,
    // Melee damage (2 = one heart).
    "attackDamage": 12.0,
    // Armor points, like player armor.
    "armor": 12.0,
    // How far the boss sees and follows players, in blocks.
    "followRange": 48.0,
    // Walking speed (a player walks at about 0.1).
    "movementSpeed": 0.24,
    // 0 = normal knockback, 1 = none at all.
    "knockbackResistance": 0.85,
    // Seconds before the shrine can summon this boss again (0 = right away).
    "shrineCooldownSeconds": 30,
    // Players within this many blocks when the boss dies get rewards.
    "participantRewardRadius": 96,
    // XP dropped when it dies.
    "xpReward": 250,
    // How long the summoning ritual takes.
    "ritualDurationSeconds": 5,
    // Allow blindness and darkness effects from this boss.
    "enableVisionEffects": true,
    // Where the boss may be summoned.
    "spawnRules": {
      // Only allow summoning in the biomes listed below.
      "enabled": true,
      // Biome ids like "minecraft:plains" or tags like "#minecraft:is_forest".
      "allowedBiomes": [
        "minecraft:forest",
        "minecraft:dark_forest",
        "minecraft:old_growth_pine_taiga",
        "minecraft:old_growth_spruce_taiga",
        "minecraft:old_growth_birch_forest"
