      // Seconds after the boss appears before it may use this skill.
      "initialDelaySeconds": 8,
      // Seconds before the skill can be used again.
      "cooldownSeconds": 12,
      // Range of the skill, in blocks.
      "radius": 10.0,
      // Particles shown for it.
      "particleCount": 80
    },
    // Sylvaron: a slam that damages everyone around him.
    "thornSlam": {
      // Damage per hit (2 = one heart).
      "damage": 7.0,
